# --- Firmware / Pioneer artifacts (never commit) -------------------------
*.UPD
*.upd
*.iso
*.bin
*.mot
*.cramfs
*.tar.gz
*.tar.bz2
*.tar.xz

# Firmware decryption key (user-supplied, never commit)
keys/*.key
keys/*.bin

# Extracted firmware tree (you generate this locally)
/extracted/*
!/extracted/README.md

# Deployment artifacts (contains patched proprietary binaries, chroot images)
/deploy/
/deploy/*

# Pioneer / Denon binaries
rbp
rbp-*

# --- Built shims / objects -------------------------------------------------
*.o
*.so
*.so.*
*.a
*.elf
scripts/shims/seqinject2
scripts/shims/udplog

# --- Rust ------------------------------------------------------------------
target/
Cargo.lock

# --- Python / tooling junk -------------------------------------------------
.venv/
__pycache__/
*.py[cod]
.coverage
htmlcov/

# --- OS / editor / tooling junk --------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~
.tmp/
.cache/
.codegraph/
.pi-subagents/
